# Managed by Ansible
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket {{ haproxy_socket_path }} mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    maxconn {{ haproxy_maxconn }}

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    option  http-server-close
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    timeout http-request 10s
    retries 3

frontend http_in
    bind {{ haproxy_bind_address }}:{{ haproxy_http_port }}
    http-request set-header X-Forwarded-Proto http
    http-response set-header X-LB-Node "{{ inventory_hostname }}"
    default_backend {{ haproxy_backend_name }}

backend {{ haproxy_backend_name }}
    balance {{ haproxy_balance_algorithm }}
    option httpchk GET {{ haproxy_health_uri }}
    http-check expect status 200
{% for host in groups[haproxy_backend_group] | sort %}
    server {{ host }} {{ hostvars[host].ansible_host }}:{{ haproxy_backend_port }} check inter {{ haproxy_check_interval }} fall {{ haproxy_check_fall }} rise {{ haproxy_check_rise }}
{% endfor %}

{% if haproxy_stats_enable %}
listen stats
    bind {{ haproxy_bind_address }}:{{ haproxy_stats_port }}
    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats refresh 5s
    stats show-node
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
{% endif %}